    <script>
        // Enroll in package
        function enrollInPackage(packageId) {
            // Check if user is logged in via localStorage
            const user = localStorage.getItem('learnSignUser');
            
            if (packageId === 'basic') {
                if (user) {
                    const userData = JSON.parse(user);
                    alert(`🎉 Welcome ${userData.name}! Redirecting to courses...`);
                    window.location.href = '/courses';
                } else {
                    alert('Please log in to access the Basic package');
                    window.location.href = '/login';
                }
            } else if (packageId === 'personal-tutor') {
                if (user) {
                    alert('🎉 Great choice! Redirecting to tutor selection...');
                    // For now, redirect to a placeholder or show coming soon
                    window.location.href = '/tutor';
                } else {
                    alert('Please log in to choose your personal tutor');
                    window.location.href = '/login';
                }
            } else if (packageId === 'institution') {
                contactForInstitution();
            }
        }

        // View tutors page
        function viewTutors() {
            alert('👨‍🏫 Tutor profiles coming soon! Contact us for more info.');
            // window.location.href = '/tutors';
        }

        // Show contact popup
        function showContactPopup() {
            const popup = document.getElementById('contact-popup');
            popup.classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        // Close contact popup
        function closeContactPopup(event) {
            if (event.target.classList.contains('contact-popup-overlay') || 
                event.target.classList.contains('popup-close-btn')) {
                const popup = document.getElementById('contact-popup');
                popup.classList.remove('active');
                document.body.style.overflow = 'auto';
            }
        }

        // Contact for institution (for CTA button)
        function contactForInstitution() {
            showContactPopup();
        }

        // Add scroll animations
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateY(0)';
                }
            });
        }, observerOptions);

        // Observe all animated elements
        document.addEventListener('DOMContentLoaded', () => {
            // Animate package cards
            document.querySelectorAll('.package-card').forEach((card, index) => {
                card.style.opacity = '0';
                card.style.transform = 'translateY(30px)';
                card.style.transition = `opacity 0.6s ease ${index * 0.2}s, transform 0.6s ease ${index * 0.2}s`;
                observer.observe(card);
            });

            // Animate testimonial cards
            document.querySelectorAll('.testimonial-card').forEach((card, index) => {
                card.style.opacity = '0';
                card.style.transform = 'translateY(30px)';
                card.style.transition = `opacity 0.6s ease ${index * 0.1}s, transform 0.6s ease ${index * 0.1}s`;
                observer.observe(card);
            });
        });
    </script>
</body>
</html>