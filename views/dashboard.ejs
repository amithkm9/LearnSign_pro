<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head') %>
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="/css/dashboard-quiz.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
</head>

<body>
    <%- include('./partials/header') %>

    <main id="dashboard-content">
        <!-- Welcome Section -->
        <section class="dashboard-welcome">
            <div class="container">
                <div class="welcome-header">
                    <div class="welcome-content">
                        <h1 id="welcome-message">Welcome to Your learnSign Dashboard</h1>
                        <p>Track your progress and continue your sign language learning journey</p>
                    </div>
                    <div class="dashboard-stats">
                        <div class="stat-item">
                            <div class="stat-icon">📚</div>
                            <div class="stat-info">
                                <span class="stat-number" id="completed-courses">0</span>
                                <span class="stat-label">Courses Completed</span>
                            </div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-icon">⏱️</div>
                            <div class="stat-info">
                                <span class="stat-number" id="weekly-minutes">0</span>
                                <span class="stat-label">Minutes This Week</span>
                            </div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-icon">🔥</div>
                            <div class="stat-info">
                                <span class="stat-number" id="current-streak">0</span>
                                <span class="stat-label">Day Streak</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Parent Summary Card - Quick Overview for Teachers/Parents -->
        <section class="parent-summary-section">
            <div class="container">
                <div class="parent-summary-card" id="parent-summary-card">
                    <div class="summary-header">
                        <div class="summary-title">
                            <span class="summary-icon">👨‍👩‍👧</span>
                            <h3>Quick Summary for Parents & Teachers</h3>
                        </div>
                        <a href="/report" class="view-full-report-btn">
                            <span>📄</span> View Full Report
                        </a>
                    </div>
                    <div class="summary-body">
                        <div class="summary-status good">
                            <span class="status-emoji">👍</span>
                            <p class="status-text">Loading progress...</p>
                        </div>
                        <div class="summary-insights">
                            <h4>Key Insights</h4>
                            <ul class="key-insights">
                                <li>Loading learning data...</li>
                            </ul>
                        </div>
                    </div>
                    <div class="summary-footer">
                        <p class="summary-tip">💡 <strong>Tip:</strong> Encourage 15-20 minutes of daily practice for best results</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Detailed Progress Section -->
        <section class="learning-progress">
            <div class="container">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
                    <h2>📈 Your Learning Progress</h2>
                    <button onclick="loadDashboardData()" class="refresh-btn">
                        🔄 Refresh Data
                    </button>
                </div>
                
                <!-- Overall Progress -->
                <div class="progress-overview">
                    <div class="progress-main-card">
                        <div class="progress-header">
                            <h3>Overall Learning Progress</h3>
                            <span class="progress-percentage" id="overall-percentage">0%</span>
                        </div>
                        <div class="progress-bar-large">
                            <div class="progress-fill" id="overall-progress" style="width: 0%"></div>
                        </div>
                        <div class="progress-details">
                            <div class="detail-item">
                                <span class="detail-label">Lessons Completed:</span>
                                <span class="detail-value" id="lessons-completed">0 / 50</span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Time Spent Learning:</span>
                                <span class="detail-value" id="time-spent">0 hours</span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Last Activity:</span>
                                <span class="detail-value" id="last-activity">Get started today!</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Quiz Performance (MOVED UP - Parents care about this) -->
                <div class="quiz-performance">
                    <h3>🎯 Quiz Performance</h3>
                    <div class="quiz-stats-grid">
                        <div class="quiz-stat-card">
                            <div class="quiz-stat-icon">📝</div>
                            <div class="quiz-stat-content">
                                <span class="quiz-stat-number" id="quiz-attempts">0</span>
                                <span class="quiz-stat-label">Quizzes Taken</span>
                            </div>
                        </div>
                        <div class="quiz-stat-card">
                            <div class="quiz-stat-icon">⭐</div>
                            <div class="quiz-stat-content">
                                <span class="quiz-stat-number" id="avg-quiz-score">0%</span>
                                <span class="quiz-stat-label">Average Score</span>
                            </div>
                        </div>
                        <div class="quiz-stat-card">
                            <div class="quiz-stat-icon">✅</div>
                            <div class="quiz-stat-content">
                                <span class="quiz-stat-number" id="quiz-pass-rate">0%</span>
                                <span class="quiz-stat-label">Pass Rate</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Learning Streak Calendar (MOVED UP - Engaging visual) -->
                <div class="streak-calendar-section">
                    <h3>🔥 Learning Streak Calendar</h3>
                    <div class="streak-info">
                        <div class="streak-stat">
                            <span class="streak-number" id="current-streak-display">0</span>
                            <span class="streak-label">Current Streak</span>
                        </div>
                        <div class="streak-stat">
                            <span class="streak-number" id="longest-streak">0</span>
                            <span class="streak-label">Longest Streak</span>
                        </div>
                        <div class="streak-stat">
                            <span class="streak-number" id="total-days-active">0</span>
                            <span class="streak-label">Total Days Active</span>
                        </div>
                    </div>
                    <div class="calendar-grid" id="streakCalendar">
                        <!-- Calendar will be generated by JavaScript -->
                    </div>
                </div>

                <!-- Charts Grid (MOVED DOWN - Less critical for quick overview) -->
                <div class="charts-grid">
                    <!-- Weekly Activity Chart -->
                    <div class="chart-card">
                        <div class="chart-header">
                            <h3>📅 Weekly Activity</h3>
                            <span class="chart-subtitle">Learning minutes per day</span>
                        </div>
                        <div class="chart-container">
                            <canvas id="weeklyActivityChart"></canvas>
                        </div>
                    </div>

                    <!-- Progress Distribution Chart -->
                    <div class="chart-card">
                        <div class="chart-header">
                            <h3>🎯 Progress by Category</h3>
                            <span class="chart-subtitle">Your learning distribution</span>
                        </div>
                        <div class="chart-container">
                            <canvas id="progressDonutChart"></canvas>
                        </div>
                    </div>
                </div>

                <!-- Detailed Performance Metrics (Collapsible) -->
                <div class="collapsible-section" id="detailed-metrics-section">
                    <div class="collapsible-header" onclick="toggleCollapsible('detailed-metrics-section')">
                        <h3>📊 Detailed Performance Metrics</h3>
                        <span class="collapsible-toggle">▼</span>
                    </div>
                    <div class="collapsible-content">
                        <div class="metrics-grid" style="margin-top: 1.5rem;">
                            <div class="metric-card purple-gradient" id="accuracy-card">
                                <div class="metric-icon">💯</div>
                                <div class="metric-content">
                                    <span class="metric-value" id="accuracy-rate">0%</span>
                                    <span class="metric-label">Accuracy Rate</span>
                                </div>
                                <div class="metric-trend up">Loading...</div>
                            </div>

                            <div class="metric-card blue-gradient" id="achievements-card">
                                <div class="metric-icon">🏆</div>
                                <div class="metric-content">
                                    <span class="metric-value" id="achievements-earned">0</span>
                                    <span class="metric-label">Achievements</span>
                                </div>
                                <div class="metric-trend">Loading...</div>
                            </div>

                            <div class="metric-card green-gradient" id="signs-card">
                                <div class="metric-icon">📊</div>
                                <div class="metric-content">
                                    <span class="metric-value" id="total-signs">0</span>
                                    <span class="metric-label">Signs Mastered</span>
                                </div>
                                <div class="metric-trend up">Loading...</div>
                            </div>

                            <div class="metric-card orange-gradient" id="session-card">
                                <div class="metric-icon">⚡</div>
                                <div class="metric-content">
                                    <span class="metric-value" id="avg-session">0m</span>
                                    <span class="metric-label">Avg Session</span>
                                </div>
                                <div class="metric-trend">Loading...</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Recent Activity -->
                <div class="recent-activity">
                    <h3>📋 Recent Activity</h3>
                    <div class="activity-list" id="recent-activity-list">
                        <div class="activity-item placeholder">
                            <div class="activity-icon">🎯</div>
                            <div class="activity-content">
                                <p>Start your first lesson to see your activity here!</p>
                                <span class="activity-time">Ready to begin</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Quick Actions -->
        <section class="quick-actions">
            <div class="container">
                <h2>🚀 Quick Actions</h2>
                <div class="actions-grid">
                    <a href="/tutorials" class="action-card">
                        <div class="action-icon">📹</div>
                        <h3>Start with Tutorials</h3>
                        <p>Basic introduction videos</p>
                    </a>
                    <a href="/quiz" class="action-card">
                        <div class="action-icon">🧠</div>
                        <h3>Take a Quiz</h3>
                        <p>Test your knowledge</p>
                    </a>
                    <a href="/translate" class="action-card">
                        <div class="action-icon">🤝</div>
                        <h3>Try Translator</h3>
                        <p>Practice real-time translation</p>
                    </a>
                    <a href="/community" class="action-card">
                        <div class="action-icon">👥</div>
                        <h3>Join Community</h3>
                        <p>Connect with other learners</p>
                    </a>
                </div>
            </div>
        </section>
    </main>

    <%- include('./partials/footer') %>

    <script>
        // Enroll in package
        function enrollInPackage(packageId) {
            // In a real app, this would handle enrollment
            alert(`Enrolling in package: ${packageId}. This would redirect to the course content!`);
            
            // For now, redirect to courses
            window.location.href = '/courses';
        }

        // Preview category
        function previewCategory(categoryId) {
            // Show a quick preview modal or redirect
            alert(`This would show a quick preview of the ${categoryId} age group courses!`);
        }

        // Add smooth scrolling for internal links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                document.querySelector(this.getAttribute('href')).scrollIntoView({
                    behavior: 'smooth'
                });
            });
        });

        // Fetch comprehensive analytics
        async function loadDashboardData() {
            try {
                const userId = localStorage.getItem('userId');
                console.log('Loading dashboard for userId:', userId);
                
                if (!userId) {
                    console.error('No userId found in localStorage');
                    console.log('Available localStorage keys:', Object.keys(localStorage));
                    alert('Please log in again to see your dashboard data');
                    return;
                }
                
                // Fetch summary analytics
                const res = await fetch(`/api/analytics/summary/${userId}`);
                if (!res.ok) {
                    console.error('Failed to fetch analytics:', res.status);
                    return;
                }
                
                const data = await res.json();
                console.log('Dashboard data:', data);
                
                // Update top stats
                document.getElementById('completed-courses').textContent = data.totalCompleted || 0;
                document.getElementById('weekly-minutes').textContent = data.weeklyMinutes || 0;
                document.getElementById('current-streak').textContent = data.currentStreak || 0;
                
                // Update overall progress
                const completionPct = data.completionPct || 0;
                document.getElementById('overall-percentage').textContent = `${completionPct}%`;
                document.getElementById('overall-progress').style.width = `${completionPct}%`;
                
                // Update lessons completed
                const totalCourses = data.coursesInProgress + data.totalCompleted;
                document.getElementById('lessons-completed').textContent = `${data.totalCompleted} / ${totalCourses}`;
                
                // Update time spent (convert minutes to hours if > 60)
                const minutes = data.weeklyMinutes || 0;
                const timeText = minutes >= 60 
                    ? `${Math.floor(minutes / 60)}h ${minutes % 60}m` 
                    : `${minutes} min`;
                document.getElementById('time-spent').textContent = timeText;
                
                // Update quiz stats
                document.getElementById('quiz-attempts').textContent = data.quizAttempts || 0;
                document.getElementById('avg-quiz-score').textContent = `${data.avgQuiz || 0}%`;
                document.getElementById('quiz-pass-rate').textContent = `${data.quizPassRate || 0}%`;
                
                // Update performance metrics with REAL data (not hardcoded!)
                document.getElementById('accuracy-rate').textContent = `${data.avgQuiz || 0}%`;
                document.getElementById('achievements-earned').textContent = data.achievementsCount || 0;
                document.getElementById('total-signs').textContent = data.estimatedSignsLearned || 0;
                document.getElementById('avg-session').textContent = `${data.avgSessionMinutes || 0}m`;
                
                // Update streak calendar stats with REAL data
                document.getElementById('current-streak-display').textContent = data.currentStreak || 0;
                document.getElementById('longest-streak').textContent = data.longestStreak || 0;
                document.getElementById('total-days-active').textContent = data.totalDaysActive || 0;
                
                // Update metric trends based on real performance
                updateMetricTrends(data);
                
                // Update charts with real data
                if (data.weeklyActivity && weeklyChart) {
                    weeklyChart.data.datasets[0].data = data.weeklyActivity;
                    weeklyChart.update();
                }
                
                // Store data globally for parent summary
                window.dashboardData = data;
                updateParentSummary(data);
                
                // Fetch and display recent activity
                await loadRecentActivity(userId);
                
            } catch (error) {
                console.error('Error loading dashboard data:', error);
            }
        }
        
        // Update metric trend labels based on actual data
        function updateMetricTrends(data) {
            const accuracyTrend = document.querySelector('.metric-card.purple-gradient .metric-trend');
            const achievementsTrend = document.querySelector('.metric-card.blue-gradient .metric-trend');
            const signsTrend = document.querySelector('.metric-card.green-gradient .metric-trend');
            const sessionTrend = document.querySelector('.metric-card.orange-gradient .metric-trend');
            
            // Accuracy trend based on quiz performance
            if (accuracyTrend) {
                if (data.avgQuiz >= 80) {
                    accuracyTrend.textContent = '🌟 Excellent!';
                    accuracyTrend.className = 'metric-trend up';
                } else if (data.avgQuiz >= 60) {
                    accuracyTrend.textContent = '📈 Good progress';
                    accuracyTrend.className = 'metric-trend';
                } else {
                    accuracyTrend.textContent = '💪 Keep practicing';
                    accuracyTrend.className = 'metric-trend';
                }
            }
            
            // Achievements trend
            if (achievementsTrend) {
                const count = data.achievementsCount || 0;
                achievementsTrend.textContent = count > 0 ? `🎖️ ${count} earned!` : '🎖️ Start earning!';
            }
            
            // Signs trend
            if (signsTrend) {
                const signs = data.estimatedSignsLearned || 0;
                if (signs > 30) {
                    signsTrend.textContent = '🚀 Great collection!';
                    signsTrend.className = 'metric-trend up';
                } else if (signs > 0) {
                    signsTrend.textContent = `📚 Learning: ${signs} signs`;
                    signsTrend.className = 'metric-trend';
                } else {
                    signsTrend.textContent = '🌱 Start learning!';
                    signsTrend.className = 'metric-trend';
                }
            }
            
            // Session trend
            if (sessionTrend) {
                const avg = data.avgSessionMinutes || 0;
                if (avg >= 20) {
                    sessionTrend.textContent = '⭐ Great focus!';
                    sessionTrend.className = 'metric-trend up';
                } else if (avg >= 10) {
                    sessionTrend.textContent = '⏱️ Good sessions';
                    sessionTrend.className = 'metric-trend';
                } else {
                    sessionTrend.textContent = '⏱️ Try longer sessions';
                    sessionTrend.className = 'metric-trend';
                }
            }
        }
        
        // Update parent summary card
        function updateParentSummary(data) {
            const summaryCard = document.getElementById('parent-summary-card');
            if (!summaryCard) return;
            
            // Determine overall status
            let status = 'good';
            let statusEmoji = '👍';
            let statusText = 'Great progress this week!';
            
            const daysPracticed = data.daysPracticedThisWeek || 0;
            const avgQuiz = data.avgQuiz || 0;
            const streak = data.currentStreak || 0;
            
            if (daysPracticed >= 5 && avgQuiz >= 70 && streak >= 3) {
                status = 'excellent';
                statusEmoji = '🌟';
                statusText = 'Excellent progress! Keep it up!';
            } else if (daysPracticed >= 3 && avgQuiz >= 50) {
                status = 'good';
                statusEmoji = '👍';
                statusText = 'Good progress this week!';
            } else if (daysPracticed >= 1) {
                status = 'average';
                statusEmoji = '📊';
                statusText = 'Making steady progress';
            } else {
                status = 'needs-attention';
                statusEmoji = '💪';
                statusText = 'Encourage more practice this week';
            }
            
            // Update status display
            const statusDisplay = summaryCard.querySelector('.summary-status');
            if (statusDisplay) {
                statusDisplay.className = `summary-status ${status}`;
                statusDisplay.querySelector('.status-emoji').textContent = statusEmoji;
                statusDisplay.querySelector('.status-text').textContent = statusText;
            }
            
            // Update key insights
            const insightsList = summaryCard.querySelector('.key-insights');
            if (insightsList) {
                insightsList.innerHTML = `
                    <li>Practiced ${daysPracticed} out of 7 days this week</li>
                    <li>Quiz average: ${avgQuiz}%${avgQuiz >= 70 ? ' ✓' : ''}</li>
                    <li>Current streak: ${streak} day${streak !== 1 ? 's' : ''}</li>
                    <li>Total learning time: ${data.totalLearningTime || 0} minutes</li>
                `;
            }
            
            // Also update metric card status indicators
            updateMetricStatusIndicators(data);
        }
        
        // Toggle collapsible sections
        function toggleCollapsible(sectionId) {
            const section = document.getElementById(sectionId);
            if (section) {
                section.classList.toggle('collapsed');
            }
        }
        
        // Update metric cards with status indicator borders based on performance
        function updateMetricStatusIndicators(data) {
            // Accuracy/Quiz performance card
            const accuracyCard = document.getElementById('accuracy-card');
            if (accuracyCard) {
                accuracyCard.classList.remove('status-excellent', 'status-good', 'status-average', 'status-needs-attention');
                if (data.avgQuiz >= 80) {
                    accuracyCard.classList.add('status-excellent');
                } else if (data.avgQuiz >= 60) {
                    accuracyCard.classList.add('status-good');
                } else if (data.avgQuiz >= 40) {
                    accuracyCard.classList.add('status-average');
                } else {
                    accuracyCard.classList.add('status-needs-attention');
                }
            }
            
            // Signs mastered card
            const signsCard = document.getElementById('signs-card');
            if (signsCard) {
                signsCard.classList.remove('status-excellent', 'status-good', 'status-average', 'status-needs-attention');
                const signs = data.estimatedSignsLearned || 0;
                if (signs >= 50) {
                    signsCard.classList.add('status-excellent');
                } else if (signs >= 25) {
                    signsCard.classList.add('status-good');
                } else if (signs >= 10) {
                    signsCard.classList.add('status-average');
                } else {
                    signsCard.classList.add('status-needs-attention');
                }
            }
            
            // Session time card
            const sessionCard = document.getElementById('session-card');
            if (sessionCard) {
                sessionCard.classList.remove('status-excellent', 'status-good', 'status-average', 'status-needs-attention');
                const avgSession = data.avgSessionMinutes || 0;
                if (avgSession >= 20) {
                    sessionCard.classList.add('status-excellent');
                } else if (avgSession >= 10) {
                    sessionCard.classList.add('status-good');
                } else if (avgSession >= 5) {
                    sessionCard.classList.add('status-average');
                } else {
                    sessionCard.classList.add('status-needs-attention');
                }
            }
            
            // Achievements card
            const achievementsCard = document.getElementById('achievements-card');
            if (achievementsCard) {
                achievementsCard.classList.remove('status-excellent', 'status-good', 'status-average', 'status-needs-attention');
                const achievements = data.achievementsCount || 0;
                if (achievements >= 10) {
                    achievementsCard.classList.add('status-excellent');
                } else if (achievements >= 5) {
                    achievementsCard.classList.add('status-good');
                } else if (achievements >= 1) {
                    achievementsCard.classList.add('status-average');
                }
                // No status-needs-attention for achievements - it's okay to have none
            }
        }
        
        // Fetch recent learning events
        async function loadRecentActivity(userId) {
            try {
                const res = await fetch(`/api/admin/learning-events/${userId}`);
                if (!res.ok) return;
                
                const events = await res.json();
                const activityList = document.getElementById('recent-activity-list');
                
                if (!events || events.length === 0) {
                    return; // Keep placeholder
                }
                
                // Clear placeholder
                activityList.innerHTML = '';
                
                // Show last 5 events
                events.slice(0, 5).forEach(event => {
                    const item = document.createElement('div');
                    item.className = 'activity-item';
                    
                    const icon = event.type === 'start' ? '▶️' : 
                                event.type === 'end' ? '✅' : 
                                event.type === 'pause' ? '⏸️' : '📹';
                    
                    const timeAgo = getTimeAgo(new Date(event.ts));
                    const minutes = Math.round(event.activeMs / 60000);
                    
                    item.innerHTML = `
                        <div class="activity-icon">${icon}</div>
                        <div class="activity-content">
                            <p>${event.type.charAt(0).toUpperCase() + event.type.slice(1)} learning session${minutes > 0 ? ` (${minutes} min)` : ''}</p>
                            <span class="activity-time">${timeAgo}</span>
                        </div>
                    `;
                    activityList.appendChild(item);
                });
                
            } catch (error) {
                console.error('Error loading recent activity:', error);
            }
        }
        
        // Helper function to format time ago
        function getTimeAgo(date) {
            const seconds = Math.floor((new Date() - date) / 1000);
            if (seconds < 60) return 'Just now';
            const minutes = Math.floor(seconds / 60);
            if (minutes < 60) return `${minutes} min ago`;
            const hours = Math.floor(minutes / 60);
            if (hours < 24) return `${hours} hour${hours > 1 ? 's' : ''} ago`;
            const days = Math.floor(hours / 24);
            return `${days} day${days > 1 ? 's' : ''} ago`;
        }
        
        // Initialize Charts
        let weeklyChart, progressChart;
        
        function initializeCharts() {
            // Weekly Activity Chart
            const weeklyCtx = document.getElementById('weeklyActivityChart');
            if (weeklyCtx) {
                weeklyChart = new Chart(weeklyCtx, {
                    type: 'bar',
                    data: {
                        labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                        datasets: [{
                            label: 'Minutes',
                            data: [0, 0, 0, 0, 0, 0, 0], // Real data loaded from API
                            backgroundColor: 'rgba(124, 111, 219, 0.8)',
                            borderColor: 'rgba(124, 111, 219, 1)',
                            borderWidth: 2,
                            borderRadius: 8,
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: true,
                        aspectRatio: 2,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                backgroundColor: 'rgba(0, 0, 0, 0.8)',
                                padding: 12,
                                titleColor: '#fff',
                                bodyColor: '#fff',
                                borderColor: 'rgba(124, 111, 219, 0.5)',
                                borderWidth: 1
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: { color: '#718096' },
                                grid: { color: 'rgba(0, 0, 0, 0.05)' }
                            },
                            x: {
                                ticks: { color: '#718096' },
                                grid: { display: false }
                            }
                        }
                    }
                });
            }
            
            // Progress Donut Chart
            const progressCtx = document.getElementById('progressDonutChart');
            if (progressCtx) {
                progressChart = new Chart(progressCtx, {
                    type: 'doughnut',
                    data: {
                        labels: ['Alphabets', 'Numbers', 'Family', 'Feelings', 'Actions'],
                        datasets: [{
                            data: [0, 0, 0, 0, 0], // Real data loaded from API
                            backgroundColor: [
                                'rgba(124, 111, 219, 0.9)',
                                'rgba(72, 187, 120, 0.9)',
                                'rgba(237, 137, 54, 0.9)',
                                'rgba(99, 102, 241, 0.9)',
                                'rgba(236, 72, 153, 0.9)'
                            ],
                            borderWidth: 0,
                            hoverOffset: 10
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: true,
                        aspectRatio: 2,
                        plugins: {
                            legend: {
                                position: 'right',
                                labels: {
                                    padding: 15,
                                    color: '#2d3748',
                                    font: { size: 12, weight: '500' },
                                    usePointStyle: true,
                                    pointStyle: 'circle'
                                }
                            },
                            tooltip: {
                                backgroundColor: 'rgba(0, 0, 0, 0.8)',
                                padding: 12,
                                titleColor: '#fff',
                                bodyColor: '#fff',
                                callbacks: {
                                    label: function(context) {
                                        return context.label + ': ' + context.parsed + '%';
                                    }
                                }
                            }
                        }
                    }
                });
            }
        }
        
        // Generate Streak Calendar - shows empty by default, real data loaded from API
        function generateStreakCalendar() {
            const calendar = document.getElementById('streakCalendar');
            if (!calendar) return;
            
            const today = new Date();
            const days = 84; // 12 weeks
            let html = '';
            
            for (let i = days - 1; i >= 0; i--) {
                const date = new Date(today);
                date.setDate(date.getDate() - i);
                
                // Show empty calendar - real data will be loaded from API
                const level = 0;
                
                html += `<div class="calendar-day level-${level}" 
                         title="${date.toLocaleDateString()}: No activity" 
                         data-date="${date.toISOString()}"></div>`;
            }
            
            calendar.innerHTML = html;
        }
        
        // Load dashboard data on page load
        initializeCharts();
        generateStreakCalendar();
        loadDashboardData(); // Load after charts are initialized so we can update them

        // Add animation on scroll
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateY(0)';
                }
            });
        }, observerOptions);

        // Observe all cards for animation
        document.querySelectorAll('.package-card, .category-card, .progress-card, .action-card, .chart-card, .metric-card').forEach(card => {
            card.style.opacity = '0';
            card.style.transform = 'translateY(20px)';
            card.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
            observer.observe(card);
        });
    </script>
</body>
</html>
