<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head') %>
    <link rel="stylesheet" href="/css/tutor.css">
</head>

<body>
    <%- include('./partials/header') %>

    <main class="tutor-page">
        <!-- Hero Section -->
        <section class="tutor-hero">
            <div class="hero-background">
                <div class="hero-gradient"></div>
            </div>
            <div class="hero-content">
                <div class="tutor-avatar-large">
                    <span>🤟</span>
                    <span class="online-badge"></span>
                </div>
                <div class="tutor-info">
                    <h1 class="tutor-title">SignMentor</h1>
                    <p class="tutor-subtitle">Your AI Sign Language Tutor</p>
                    <div class="tutor-features">
                        <span class="feature-tag"><svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg> 354+ Signs</span>
                        <span class="feature-tag"><svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14"><path d="M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3zm5.91-3c-.49 0-.9.36-.98.85C16.52 14.2 14.47 16 12 16s-4.52-1.8-4.93-4.15c-.08-.49-.49-.85-.98-.85-.61 0-1.09.54-1 1.14.49 3 2.89 5.35 5.91 5.78V20c0 .55.45 1 1 1s1-.45 1-1v-2.08c3.02-.43 5.42-2.78 5.91-5.78.1-.6-.39-1.14-1-1.14z"/></svg> Voice Input</span>
                        <span class="feature-tag"><svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14"><path d="M21 6h-2v9H6v2c0 .55.45 1 1 1h11l4 4V7c0-.55-.45-1-1-1zm-4 6V3c0-.55-.45-1-1-1H3c-.55 0-1 .45-1 1v14l4-4h10c.55 0 1-.45 1-1z"/></svg> Real-time Help</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Chat Interface -->
        <div class="chat-fullpage">

            <!-- Chat Messages Area -->
            <div class="chat-messages-fullpage" id="chat-messages">
                <!-- Welcome Message -->
                <div class="message tutor-message welcome-message">
                    <div class="message-avatar">
                        <span>🤟</span>
                    </div>
                    <div class="message-content">
                        <div class="message-header">
                            <span class="sender-name">SignMentor</span>
                            <span class="message-time">Just now</span>
                        </div>
                        <div class="message-body">
                            <p>Hi! Hello! 👋 I'm your sign language tutor!</p>
                            <p>Just type any word and I'll show you how to sign it.</p>
                            <div class="quick-suggestions">
                                <span class="suggestions-label">Try these:</span>
                                <div class="suggestion-chips">
                                    <button class="suggestion-chip" onclick="sendQuickMessage('hello')">Hello</button>
                                    <button class="suggestion-chip" onclick="sendQuickMessage('thank you')">Thank You</button>
                                    <button class="suggestion-chip" onclick="sendQuickMessage('please')">Please</button>
                                    <button class="suggestion-chip" onclick="sendQuickMessage('help')">Help</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Chat Input -->
            <div class="chat-input-fullpage">
                <div class="chat-input-container">
                    <!-- Voice Controls -->
                    <div class="voice-controls">
                        <!-- Language Selector -->
                        <select id="language-select" class="language-select" title="Select language">
                            <option value="en">🇬🇧 English</option>
                            <option value="hi">🇮🇳 हिंदी</option>
                            <option value="kn">🇮🇳 ಕನ್ನಡ</option>
                            <option value="te">🇮🇳 తెలుగు</option>
                        </select>
                        
                        <button id="mic-btn" class="voice-btn mic-btn" title="Click to start/stop recording">
                            <svg class="mic-icon" viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
                                <path d="M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3zm-1-9c0-.55.45-1 1-1s1 .45 1 1v6c0 .55-.45 1-1 1s-1-.45-1-1V5z"/>
                                <path d="M17 11c0 2.76-2.24 5-5 5s-5-2.24-5-5H5c0 3.53 2.61 6.43 6 6.92V21h2v-3.08c3.39-.49 6-3.39 6-6.92h-2z"/>
                            </svg>
                        </button>
                        <button id="speaker-toggle" class="voice-btn speaker-btn active" title="Toggle voice responses">
                            <svg class="speaker-icon" viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
                                <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
                            </svg>
                        </button>
                    </div>
                    
                    <textarea 
                        id="chat-input" 
                        placeholder="Type or speak any word... hello, mother, love, happy..."
                        rows="1"
                        maxlength="100"
                    ></textarea>
                    <button id="send-btn" class="send-button" disabled>
                        <svg class="send-icon" viewBox="0 0 24 24" fill="currentColor" width="22" height="22">
                            <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
                        </svg>
                    </button>
                </div>
                
                <!-- Voice Recording Indicator -->
                <div id="voice-recording-indicator" class="voice-recording-indicator" style="display: none;">
                    <div class="recording-pulse"></div>
                    <span class="recording-text">Listening...</span>
                    <span class="recording-timer" id="recording-timer">0s</span>
                    <button id="stop-recording-btn" class="stop-recording-btn">Stop</button>
                </div>
                
                <!-- Voice Status Messages -->
                <div id="voice-status" class="voice-status" style="display: none;"></div>
                
                <div class="input-hints">
                    <span class="hint-text">354 signs available • Type or click mic to speak</span>
                </div>
            </div>
        </div>
    </main>

    <!-- Login Required Modal -->
    <div class="modal-overlay" id="login-modal" style="display: none;">
        <div class="modal-content">
            <div class="modal-icon">🔐</div>
            <h2>Sign In Required</h2>
            <p>Please sign in to chat with SignMentor.</p>
            <div class="modal-actions">
                <a href="/login" class="btn btn-primary">Sign In</a>
                <button class="btn btn-secondary" onclick="closeLoginModal()">Maybe Later</button>
            </div>
        </div>
    </div>

    <script src="/js/tutor.js"></script>
</body>
</html>
