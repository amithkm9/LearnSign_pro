# ============================================
# LearnSign Pro - Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# MongoDB Connection (Required)
# Get free cluster at: https://www.mongodb.com/atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/learnsign
DB_NAME=learnsign

# Server Configuration
PORT=3000
API_PORT=4000
PYTHON_API_PORT=8000
TRANSLATE_API_PORT=8001
NUMBERS_LETTERS_API_PORT=8002
NODE_ENV=production

# App URLs
CLIENT_URL=http://localhost:3000
API_URL=http://localhost:4000
PYTHON_API_URL=http://localhost:8000
TRANSLATE_API_URL=http://localhost:8001
NUMBERS_LETTERS_API_URL=http://localhost:8002

# Session Secret (Generate a random string)
SESSION_SECRET=your_super_secret_session_key_here_change_me

# OpenAI API Key (Required for AI Tutor features)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Google Translate API Key (optional, for fallback translations)
GOOGLE_TRANSLATE_API_KEY=your-google-translate-key

# Firebase Configuration (for optional client integrations)
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:abcdef1234567890
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Feature Toggles
ENABLE_ANALYTICS=true
ENABLE_USER_PROGRESS=true
ENABLE_RECOMMENDATIONS=true
ENABLE_NOTIFICATIONS=true

# Rate Limiting (defaults shown)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ============================================
# DEPLOYMENT URL PLACEHOLDERS (update per env)
# ============================================
# API_URL=https://learnsign-api.example.com
# PYTHON_API_URL=https://learnsign-ml.example.com
